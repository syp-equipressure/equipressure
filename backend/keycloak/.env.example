# Kopieren nach .env und mit den echten Werten befüllen (.env wird nicht committet!)
# Ohne diese Werte startet Keycloak trotzdem, nur der Login über den jeweiligen Anbieter funktioniert nicht.
#
# Redirect URI, die bei jedem Anbieter eingetragen werden muss:
#   http://localhost:8180/realms/equipressure/broker/<google|microsoft|github>/endpoint

# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://entra.microsoft.com -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret für das Anlegen von Benutzern durch das Backend (Keycloak:AdminClientSecret), lokal: dev-admin-secret
EQUI_API_ADMIN_SECRET=

# E-Mail-Versand (Passwort vergessen), ohne Angabe landen die Mails lokal in Mailpit
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
